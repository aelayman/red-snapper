<Application x:Class="RedSnapper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#E23A52" />
        <SolidColorBrush x:Key="AccentDark" Color="#B81E32" />
        <SolidColorBrush x:Key="Chrome" Color="#FFFAFAFB" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#FFE2E2E8" />
        <SolidColorBrush x:Key="Ink" Color="#FF2A2A30" />
        <SolidColorBrush x:Key="InkMuted" Color="#FF7A7A85" />
        <SolidColorBrush x:Key="CanvasBackdrop" Color="#FFECEDF1" />

        <!-- 24x24 stroke icons for the tool rail -->
        <Geometry x:Key="IconSelect">M6,3 L6,19 L10,15 L13,21 L15.5,20 L12.5,14 L18,14 Z</Geometry>
        <Geometry x:Key="IconArrow">M5,19 L19,5 M10,5 L19,5 L19,14</Geometry>
        <Geometry x:Key="IconLine">M5,19 L19,5</Geometry>
        <Geometry x:Key="IconRectangle">M4,6 H20 V18 H4 Z</Geometry>
        <Geometry x:Key="IconEllipse">M4,12 A8,6.5 0 1 0 20,12 A8,6.5 0 1 0 4,12 Z</Geometry>
        <Geometry x:Key="IconPen">M4,20 L5,15 L16,4 L20,8 L9,19 Z M14,6 L18,10</Geometry>
        <Geometry x:Key="IconHighlight">M8,15 L15,4 L20,8 L13,18 H8 Z M4,21 H20</Geometry>
        <Geometry x:Key="IconText">M5,7 V4 H19 V7 M12,4 V20 M9,20 H15</Geometry>
        <Geometry x:Key="IconStep">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M10,9.5 L12.5,8 V16</Geometry>
        <Geometry x:Key="IconPixelate">M4,4 H20 V20 H4 Z M4,12 H20 M12,4 V20</Geometry>
        <Geometry x:Key="IconBlur">M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 Z M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 Z</Geometry>
        <Geometry x:Key="IconRedact">M4,5 H20 V19 H4 Z M4,8.5 H20 M4,12 H20 M4,15.5 H20</Geometry>
        <Geometry x:Key="IconCrop">M7,3 V17 H21 M3,7 H17 V21</Geometry>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="11,6" Margin="2,0"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="6" Padding="14,6" Margin="2,0"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="2,0"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailTool" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="58" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="0,3,0,3"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <StackPanel>
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                    <Path Width="24" Height="24" Stretch="None" Data="{TemplateBinding Content}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{StaticResource Ink}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#40000000" StrokeThickness="1" Margin="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
