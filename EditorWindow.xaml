<Window x:Class="RedSnapper.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedSnapper"
        Title="Red Snapper Editor" Width="1180" Height="780"
        Icon="app.ico" Background="{StaticResource Chrome}" FontFamily="Segoe UI">
    <DockPanel>
        <!-- Top bar: file and history actions -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Copy Text" ToolTip="Recognize text in the image and copy it" Click="Ocr_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="Copy" Click="Copy_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="Save As…" Click="SaveAs_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open…" Click="Open_Click" Style="{StaticResource ActionButton}" />
                    <Rectangle Width="1" Margin="8,4" Fill="{StaticResource ChromeBorder}" />
                    <Button Content="↶ Undo" Click="Undo_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="↷ Redo" Click="Redo_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="🗑 Delete" Click="Delete_Click" Style="{StaticResource ActionButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar with zoom controls -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="−" ToolTip="Zoom out" Click="ZoomOut_Click" Style="{StaticResource ActionButton}" />
                    <TextBlock x:Name="ZoomText" Width="46" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink}" FontSize="12" />
                    <Button Content="+" ToolTip="Zoom in" Click="ZoomIn_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="Fit" Click="ZoomFit_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="100%" Click="Zoom100_Click" Style="{StaticResource ActionButton}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMuted}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Tool rail -->
        <Border DockPanel.Dock="Left" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6">
                <StackPanel>
                    <RadioButton Content="{StaticResource IconSelect}" ToolTip="Select" Tag="Select" GroupName="tools" IsChecked="True" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <Rectangle Height="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <RadioButton Content="{StaticResource IconArrow}" ToolTip="Arrow" Tag="Arrow" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconLine}" ToolTip="Line" Tag="Line" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconRectangle}" ToolTip="Rectangle" Tag="Rectangle" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconEllipse}" ToolTip="Ellipse" Tag="Ellipse" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconPen}" ToolTip="Pen" Tag="Pen" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconHighlight}" ToolTip="Highlight" Tag="Highlight" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <Rectangle Height="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <RadioButton Content="{StaticResource IconText}" ToolTip="Text" Tag="Text" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconStep}" ToolTip="Step" Tag="Step" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <Rectangle Height="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <RadioButton Content="{StaticResource IconPixelate}" ToolTip="Pixelate" Tag="Pixelate" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconBlur}" ToolTip="Blur" Tag="Blur" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <RadioButton Content="{StaticResource IconRedact}" ToolTip="Redact" Tag="Solid" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                    <Rectangle Height="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <RadioButton Content="{StaticResource IconCrop}" ToolTip="Crop" Tag="Crop" GroupName="tools" Click="Tool_Click" Style="{StaticResource RailTool}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Properties bar: only shows options relevant to the current tool -->
        <Border DockPanel.Dock="Top" Background="#FFF6F6F8" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="14,7">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="ToolLabel" Text="Select" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" MinWidth="64" />
                <StackPanel x:Name="ColorGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="WidthGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <TextBlock Text="Width" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="WidthSlider" Minimum="1" Maximum="12" Value="4" Width="110" ValueChanged="Width_Changed" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HeadGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <TextBlock Text="Head" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="HeadBox" Width="90" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Style_Changed">
                        <ComboBoxItem Content="Arrow" Tag="Arrow" />
                        <ComboBoxItem Content="Double" Tag="Double" />
                        <ComboBoxItem Content="Dot" Tag="Dot" />
                        <ComboBoxItem Content="Bar" Tag="Bar" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="DashedBox" Content="Dashed" Margin="14,0,0,0" VerticalAlignment="Center" Click="Style_Changed" />
                <CheckBox x:Name="FilledBox" Content="Filled" Margin="14,0,0,0" VerticalAlignment="Center" Click="Style_Changed" />
                <Button x:Name="ResetCropButton" Content="Reset crop" Click="ResetCrop_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Visibility="Collapsed" />
            </WrapPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBackdrop}" PreviewMouseWheel="Scroller_MouseWheel">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                <Border Background="White" CornerRadius="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.28" Direction="270" />
                    </Border.Effect>
                    <local:CanvasView x:Name="View" />
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
