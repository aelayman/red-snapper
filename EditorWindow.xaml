<Window x:Class="RedSnapper.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedSnapper"
        Title="Red Snapper Editor" Width="1100" Height="750">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Open…" Click="Open_Click" />
                <Button Content="Save" Click="Save_Click" />
                <Button Content="Save As…" Click="SaveAs_Click" />
                <Button Content="Copy" Click="Copy_Click" />
                <Button Content="Copy Text (OCR)" Click="Ocr_Click" />
                <Separator />
                <Button Content="Undo" Click="Undo_Click" />
                <Button Content="Redo" Click="Redo_Click" />
                <Button Content="Delete" Click="Delete_Click" />
            </ToolBar>
            <ToolBar>
                <RadioButton Content="Select" Tag="Select" GroupName="tools" IsChecked="True" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Arrow" Tag="Arrow" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Line" Tag="Line" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Rectangle" Tag="Rectangle" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Ellipse" Tag="Ellipse" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Highlight" Tag="Highlight" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Text" Tag="Text" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Step" Tag="Step" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Pixelate" Tag="Pixelate" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
                <RadioButton Content="Redact" Tag="Solid" GroupName="tools" Click="Tool_Click" Style="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}" />
            </ToolBar>
            <ToolBar>
                <TextBlock Text="Color " VerticalAlignment="Center" />
                <ComboBox x:Name="ColorBox" Width="70" SelectionChanged="Color_Changed" />
                <TextBlock Text="  Width " VerticalAlignment="Center" />
                <Slider x:Name="WidthSlider" Minimum="1" Maximum="12" Value="4" Width="90" ValueChanged="Width_Changed" VerticalAlignment="Center" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF2B2B2B" PreviewMouseWheel="Scroller_MouseWheel">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <local:CanvasView x:Name="View" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
