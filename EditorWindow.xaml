<Window x:Class="RedSnapper.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RedSnapper"
        Title="Red Snapper Editor" Width="1100" Height="750"
        Icon="app.ico" Background="{StaticResource Chrome}" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Chrome}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy Text (OCR)" Click="Ocr_Click" Style="{StaticResource ActionButton}" />
                        <Button Content="Copy" Click="Copy_Click" Style="{StaticResource ActionButton}" />
                        <Button Content="Save As…" Click="SaveAs_Click" Style="{StaticResource ActionButton}" />
                        <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open…" Click="Open_Click" Style="{StaticResource ActionButton}" />
                        <Rectangle Width="1" Margin="8,4" Fill="{StaticResource ChromeBorder}" />
                        <Button Content="↶ Undo" Click="Undo_Click" Style="{StaticResource ActionButton}" />
                        <Button Content="↷ Redo" Click="Redo_Click" Style="{StaticResource ActionButton}" />
                        <Button Content="🗑 Delete" Click="Delete_Click" Style="{StaticResource ActionButton}" />
                    </StackPanel>
                </DockPanel>
                <Rectangle Height="1" Margin="0,8" Fill="{StaticResource ChromeBorder}" />
                <WrapPanel>
                    <RadioButton Content="➤ Select" Tag="Select" GroupName="tools" IsChecked="True" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="↗ Arrow" Tag="Arrow" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="╱ Line" Tag="Line" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="▭ Rectangle" Tag="Rectangle" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="◯ Ellipse" Tag="Ellipse" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="▮ Highlight" Tag="Highlight" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="✎ Pen" Tag="Pen" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="T Text" Tag="Text" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="① Step" Tag="Step" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="▦ Pixelate" Tag="Pixelate" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="◌ Blur" Tag="Blur" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="■ Redact" Tag="Solid" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <RadioButton Content="⌗ Crop" Tag="Crop" GroupName="tools" Click="Tool_Click" Style="{StaticResource ToolToggle}" />
                    <Button x:Name="ResetCropButton" Content="Reset crop" Click="ResetCrop_Click" Style="{StaticResource ActionButton}" Visibility="Collapsed" />
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <TextBlock Text="Width" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="WidthSlider" Minimum="1" Maximum="12" Value="4" Width="100" ValueChanged="Width_Changed" VerticalAlignment="Center" />
                    <Rectangle Width="1" Margin="10,4" Fill="{StaticResource ChromeBorder}" />
                    <TextBlock Text="Arrow" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="HeadBox" Width="90" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Style_Changed">
                        <ComboBoxItem Content="Arrow" Tag="Arrow" />
                        <ComboBoxItem Content="Double" Tag="Double" />
                        <ComboBoxItem Content="Dot" Tag="Dot" />
                        <ComboBoxItem Content="Bar" Tag="Bar" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                    <CheckBox x:Name="DashedBox" Content="Dashed" Margin="10,0,0,0" VerticalAlignment="Center" Click="Style_Changed" />
                    <CheckBox x:Name="FilledBox" Content="Filled" Margin="10,0,0,0" VerticalAlignment="Center" Click="Style_Changed" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMuted}" FontSize="12" />
        </Border>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBackdrop}" PreviewMouseWheel="Scroller_MouseWheel">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <Border Background="White" BorderBrush="#33000000" BorderThickness="1">
                    <local:CanvasView x:Name="View" />
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
