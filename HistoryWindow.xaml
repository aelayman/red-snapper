<Window x:Class="RedSnapper.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Red Snapper History" Width="980" Height="680" MinWidth="560" MinHeight="400"
        Background="{StaticResource Chrome}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="CountText" Foreground="{StaticResource InkMuted}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <Grid>
                    <TextBox x:Name="SearchBox" FontSize="15" Padding="10,7" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource ChromeBorder}" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="Search text inside your screenshots…" IsHitTestVisible="False" FontSize="15"
                               Foreground="{StaticResource InkMuted}" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown" SelectionChanged="List_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="220" Margin="4" Padding="8" Background="White" CornerRadius="8"
                            BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <StackPanel>
                            <Border Height="130" Background="#FFF0F0F3" CornerRadius="4" ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{Binding When}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource InkMuted}" FontSize="15" IsHitTestVisible="False" />

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open folder" Style="{StaticResource ActionButton}" Click="OpenFolder_Click" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Open in editor" Style="{StaticResource PrimaryButton}" Click="Open_Click" />
                    <Button x:Name="CopyTextButton" Content="Copy text" Style="{StaticResource ActionButton}" Click="CopyText_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource ActionButton}" Click="Delete_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
