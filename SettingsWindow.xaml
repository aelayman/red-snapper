<Window x:Class="RedSnapper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Red Snapper Settings" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        Icon="app.ico" Background="{StaticResource Chrome}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="Hotkeys" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
        <TextBlock Text="Click a box, then press the keys you want. Backspace clears it." Foreground="{StaticResource InkMuted}" Margin="0,2,0,10" />

        <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Capture a region" VerticalAlignment="Center" Margin="0,5" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="RegionBox" IsReadOnly="True" Margin="0,5" Padding="8,5" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Row="1" Text="Capture a region (second key)" VerticalAlignment="Center" Margin="0,5" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AltRegionBox" IsReadOnly="True" Margin="0,5" Padding="8,5" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Row="2" Text="Capture the full screen" VerticalAlignment="Center" Margin="0,5" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FullBox" IsReadOnly="True" Margin="0,5" Padding="8,5" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                <TextBlock Grid.Row="3" Text="Open History" VerticalAlignment="Center" Margin="0,5" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="HistoryBox" IsReadOnly="True" Margin="0,5" Padding="8,5" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
            </Grid>
        </Border>

        <CheckBox x:Name="SnippingBox" Margin="0,10,0,0"
                  Content="Let Red Snapper use Print Screen (turns off Windows' Snipping Tool shortcut)" />

        <TextBlock Text="Saving" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,18,0,6" />
        <TextBlock Text="Default folder for Save and Save As (blank = Pictures\Red Snapper)" Foreground="{StaticResource InkMuted}" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Style="{StaticResource ActionButton}" Margin="6,0,0,0" />
            <TextBox x:Name="FolderBox" Padding="8,5" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentDark}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Reset to defaults" Click="Reset_Click" Style="{StaticResource ActionButton}" />
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ActionButton}" />
            <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
